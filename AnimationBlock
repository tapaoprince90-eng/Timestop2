          package com.example.animtool.client;

          import net.minecraft.client.gui.DrawContext;
          import net.minecraft.client.gui.screen.Screen;
          import net.minecraft.client.gui.widget.ButtonWidget;
          import net.minecraft.client.gui.widget.SliderWidget;
          import net.minecraft.text.Text;
          import net.minecraft.util.Formatting;

          import java.util.Arrays;
          import java.util.Locale;

          public class StickScreen extends Screen {

              private final ValueSlider[] sliders = new ValueSlider[6];
              private float[] last = new float[6];
              private int top;

              public StickScreen() {
                  super(Text.literal("Move / Rotate"));
              }

              public void refresh() {
                  for (int i = 0; i < 6; i++) {
                      if (sliders[i] != null) sliders[i].set(AnimToolClient.vals[i]);
                  }
                  last = Arrays.copyOf(AnimToolClient.vals, 6);
              }

              @Override
              protected void init() {
                  int cx = this.width / 2;
                  top = Math.max(40, this.height / 2 - 80);
                  int colL = cx - 155;
                  int colR = cx + 5;
                  String[] moveNames = {"Left/Right", "Up/Down", "Front/Back"};
                  String[] rotNames = {"Rotate X", "Rotate Y", "Rotate Z"};

                  for (int i = 0; i < 3; i++) {
                      sliders[i] = new ValueSlider(colL, top + i * 24, 150, 20, moveNames[i],
                          -6, 6, 0.05, "%.2f", AnimToolClient.vals[i], this::sendValues);
                      sliders[3 + i] = new ValueSlider(colR, top + i * 24, 150, 20, rotNames[i],
                          -180, 180, 1, "%.0f", AnimToolClient.vals[3 + i], this::sendValues);
                  }
                  for (ValueSlider s : sliders) addDrawableChild(s);
                  last = Arrays.copyOf(AnimToolClient.vals, 6);

                  int y = top + 76;
                  addDrawableChild(ButtonWidget.builder(Text.literal("<"),
                      b -> AnimToolClient.send("stick prev")).dimensions(cx - 100, y, 40, 20).build());
                  addDrawableChild(ButtonWidget.builder(Text.literal(">"),
                      b -> AnimToolClient.send("stick next")).dimensions(cx + 60, y, 40, 20).build());

                  y += 24;
                  addDrawableChild(ButtonWidget.builder(Text.literal("Reset this frame"),
                      b -> AnimToolClient.send("stick reset")).dimensions(cx - 155, y, 150, 20).build());
                  addDrawableChild(ButtonWidget.builder(Text.literal("Put back as block").formatted(Formatting.RED),
                      b -> AnimToolClient.send("stick remove")).dimensions(cx + 5, y, 150, 20).build());

                  y += 24;
                  addDrawableChild(ButtonWidget.builder(Text.literal("Close"), b -> close())
                      .dimensions(cx - 100, y, 200, 20).build());
              }

              private void sendValues() {
                  float[] v = new float[6];
                  for (int i = 0; i < 6; i++) v[i] = (float) sliders[i].get();
                  if (Arrays.equals(v, last)) return;
                  last = v;
                  System.arraycopy(v, 0, AnimToolClient.vals, 0, 6);
                  AnimToolClient.send("stick set " + v[0] + " " + v[1] + " " + v[2]
                      + " " + v[3] + " " + v[4] + " " + v[5]);
              }

              @Override
              public boolean shouldPause() {
                  return false;
              }

              @Override
              public void render(DrawContext ctx, int mouseX, int mouseY, float delta) {
                  super.render(ctx, mouseX, mouseY, delta);
                  int cx = this.width / 2;
                  ctx.drawCenteredTextWithShadow(this.textRenderer,
                      Text.literal("MOVE / ROTATE").formatted(Formatting.GOLD, Formatting.BOLD),
                      cx, top - 26, 0xFFFFFF);
                  ctx.drawCenteredTextWithShadow(this.textRenderer,
                      Text.literal("Object: " + AnimToolClient.objName),
                      cx, top - 13, 0xDDDDDD);
                  ctx.drawCenteredTextWithShadow(this.textRenderer,
                      Text.literal("Frame " + (AnimToolClient.frame + 1) + " / " + AnimToolClient.frameCount),
                      cx, top + 76 + 6, 0xFFFF55);
              }

              private static class ValueSlider extends SliderWidget {
                  private final double min, max, step;
                  private final String label, fmt;
                  private final Runnable onChange;

                  ValueSlider(int x, int y, int w, int h, String label, double min, double max,
                              double step, String fmt, double cur, Runnable onChange) {
                      super(x, y, w, h, Text.empty(), (Math.min(Math.max(cur, min), max) - min) / (max - min));
                      this.min = min;
                      this.max = max;
                      this.step = step;
                      this.label = label;
                      this.fmt = fmt;
                      this.onChange = onChange;
                      updateMessage();
                  }

                  double get() {
                      double v = min + this.value * (max - min);
                      return Math.round(v / step) * step;
                  }

                  void set(double v) {
                      this.value = Math.min(1.0, Math.max(0.0, (v - min) / (max - min)));
                      updateMessage();
                  }

                  @Override
                  protected void updateMessage() {
                      if (label == null) return;
                      setMessage(Text.literal(label + ": " + String.format(Locale.ROOT, fmt, get())));
                  }

                  @Override
                  protected void applyValue() {
                      onChange.run();
                  }
              }
          }
