          package com.example.animtool.client;

          import com.example.animtool.ClientMsg;
          import com.example.animtool.ServerMsg;
          import net.fabricmc.api.ClientModInitializer;
          import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
          import net.minecraft.client.MinecraftClient;

          public class AnimToolClient implements ClientModInitializer {

              public static int frame = 0;
              public static int frameCount = 2;
              public static int speed = 20;
              public static int objects = 0;
              public static boolean playing = false;
              public static float[] vals = new float[6];
              public static String objName = "object";

              @Override
              public void onInitializeClient() {
                  ClientPlayNetworking.registerGlobalReceiver(ServerMsg.ID, (payload, context) ->
                      handle(context.client(), payload.text()));
              }

              public static void send(String text) {
                  ClientPlayNetworking.send(new ClientMsg(text));
              }

              static void handle(MinecraftClient mc, String text) {
                  try {
                      String[] s = text.split(" ");
                      if (s[0].equals("paper")) {
                          frame = Integer.parseInt(s[2]);
                          frameCount = Integer.parseInt(s[3]);
                          playing = s[4].equals("1");
                          speed = Integer.parseInt(s[5]);
                          objects = Integer.parseInt(s[6]);
                          if (s[1].equals("open")) {
                              mc.setScreen(new PaperScreen());
                          } else if (mc.currentScreen instanceof PaperScreen ps) {
                              ps.refresh();
                          }
                      } else if (s[0].equals("stick")) {
                          if (s[1].equals("close")) {
                              if (mc.currentScreen instanceof StickScreen) mc.setScreen(null);
                              return;
                          }
                          frame = Integer.parseInt(s[2]);
                          frameCount = Integer.parseInt(s[3]);
                          for (int i = 0; i < 6; i++) vals[i] = Float.parseFloat(s[4 + i]);
                          objName = s[10];
                          if (s[1].equals("open")) {
                              mc.setScreen(new StickScreen());
                          } else if (mc.currentScreen instanceof StickScreen ss) {
                              ss.refresh();
                          }
                      }
                  } catch (Exception ignored) {
                  }
              }
          }
